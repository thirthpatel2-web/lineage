# Copy to .env.local and fill in. Every value is optional: without keys Lineage
# runs in a clearly-labelled offline mode so you can explore it.

# Public URL of this app (used for PayPal return URLs, QR tags and lineage.json)
APP_URL=http://localhost:3000

# PayPal sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook id from the same app's Webhooks section (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# Your sandbox business account email (the invoicer on license offers)
PAYPAL_MERCHANT_EMAIL=

# A sandbox PERSONAL account email. Demo designers and makers are paid here, so payouts show as paid.
DEMO_PAYEE_EMAIL=

# Free AI: a Gemini API key from https://aistudio.google.com/apikey (no billing needed).
# Powers vision matching, license reading, the agents and the AG Studio assistant.
GEMINI_API_KEY=
# Optional: pick a different free model (default gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional and paid: use Claude instead of Gemini
ANTHROPIC_API_KEY=

# Postgres connection string. Leave empty to use the embedded database in ./.data
DATABASE_URL=

# Channel3 product search (optional, used by the shopping agent for outside listings)
CHANNEL3_API_KEY=

# AG Studio licence key (optional; Studio runs with a watermark without it)
AG_STUDIO=

# Lineage's cut of each royalty, in basis points (1000 = 10%)
PLATFORM_FEE_BP=1000

# Most AI requests the whole demo may make per day (protects free-tier quota)
AI_DAILY_LIMIT=500
